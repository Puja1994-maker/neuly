          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="SWAN resolve project root" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def normalize = { String p -&gt;
    if (p == null || p.isEmpty()) return null
    def n = p.replace(&apos;\\&apos;, &apos;/&apos;)
    return n.endsWith(&apos;/&apos;) ? n : n + &apos;/&apos;
}
def root = normalize(props.get(&apos;neuly_jmeter_root&apos;) as String)
if (root == null) root = normalize(vars.get(&apos;neuly_jmeter_root&apos;) as String)
if (root == null) {
    def base = org.apache.jmeter.services.FileServer.getFileServer().getBaseDir()
    def f = new File(base)
    if (new File(f, &apos;groovy/swan_build_report_payload.groovy&apos;).isFile()) {
        root = normalize(f.getAbsolutePath())
    }
}
if (root != null) props.put(&apos;neuly_jmeter_root&apos;, root)</stringProp>
          </JSR223PreProcessor>
