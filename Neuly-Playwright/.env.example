# Copy to .env (never commit .env)
NEULY_BASE_URL=https://demo.neuly.ai
GAD7_SEND_REPORT=false

# Stable report recipient for all screener email PDFs
REPORT_EMAIL=pihusuryavanshi502@gmail.com

# Report submission gating
# Master switch: set SEND_REPORTS=true to allow submissions for all screeners.
# Screener-specific: set GAD7_SEND_REPORT=true to allow only GAD-7 submissions.
# Parent flows: set PARENT_SEND_REPORT=true to allow submissions for parent/child screeners.
SEND_REPORTS=false
PARENT_SEND_REPORT=false

# Optional: only set these if Microsoft Graph / Outlook mailbox access is approved
# MICROSOFT_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_MAILBOX_USER=

# Optional: path to a manually saved PDF for comparison
# MANUAL_PDF_PATH=evidence/GAD-7/GAD7-BASE-001/manual/report.pdf

# Run id override (auto-generated if unset)
# NEULY_RUN_ID=
